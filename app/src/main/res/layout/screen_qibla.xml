<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">
        <TextView android:id="@+id/eyebrow" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/qibla_eyebrow" android:textAppearance="@style/Text.Eyebrow" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/qibla_intro" android:textAppearance="@style/Text.Heading" android:textSize="27sp" app:layout_constraintTop_toBottomOf="@id/eyebrow" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.example.waktusolatmalaysia.customs.CompassView android:id="@+id/compass" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="20dp" android:contentDescription="@string/compass_description" android:importantForAccessibility="yes" app:layout_constraintDimensionRatio="1:1" app:layout_constraintWidth_max="320dp" app:layout_constraintTop_toBottomOf="@id/title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/bearing" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/empty_time" android:textAppearance="@style/Text.Heading" android:textSize="36sp" android:gravity="center" app:layout_constraintTop_toBottomOf="@id/compass" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/alignment" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/qibla_help" android:textColor="@color/prayer_text" android:textSize="13sp" android:gravity="center" app:layout_constraintTop_toBottomOf="@id/bearing" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
<TextView android:id="@+id/coordinates" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/location_required" android:textAppearance="@style/Text.Body" android:gravity="center" android:textSize="13sp" app:layout_constraintTop_toBottomOf="@id/alignment" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.button.MaterialButton android:id="@+id/locate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/get_location" app:layout_constraintTop_toBottomOf="@id/coordinates" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/sensor_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textSize="13sp" android:textColor="@color/text_secondary" app:layout_constraintTop_toBottomOf="@id/locate" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/guide_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/qibla_guide_title" android:textSize="17sp" android:fontFamily="@font/jakarta_bold" app:layout_constraintTop_toBottomOf="@id/sensor_status" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/guide_body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/qibla_help" android:textAppearance="@style/Text.Body" android:textSize="13sp" app:layout_constraintTop_toBottomOf="@id/guide_title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.button.MaterialButton android:id="@+id/reference" style="@style/Widget.App.TextButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/guide_body" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
