<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp">
        <TextView android:id="@+id/eyebrow" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/zone_eyebrow" android:textAppearance="@style/Text.Eyebrow" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/zone_title" android:textAppearance="@style/Text.Heading" android:textSize="27sp" app:layout_constraintTop_toBottomOf="@id/eyebrow" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/hint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/select_district" android:textAppearance="@style/Text.Body" app:layout_constraintTop_toBottomOf="@id/title" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/state_input" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="32dp" app:boxBackgroundColor="@color/surface" app:boxCornerRadiusTopStart="18dp" app:boxCornerRadiusTopEnd="18dp" app:boxCornerRadiusBottomStart="18dp" app:boxCornerRadiusBottomEnd="18dp" app:layout_constraintTop_toBottomOf="@id/hint" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <!-- The fragment restores the selected zone; do not restore an open popup over Save. -->
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/state" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:inputType="none" android:saveEnabled="false" android:hint="@string/pilihan_negeri_lbl" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/district_input" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:boxBackgroundColor="@color/surface" app:boxCornerRadiusTopStart="18dp" app:boxCornerRadiusTopEnd="18dp" app:boxCornerRadiusBottomStart="18dp" app:boxCornerRadiusBottomEnd="18dp" app:layout_constraintTop_toBottomOf="@id/state_input" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/district" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:inputType="none" android:singleLine="false" android:saveEnabled="false" android:hint="@string/pilihan_lokasi" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/save" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/save_location" app:layout_constraintTop_toBottomOf="@id/district_input" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:padding="20dp" android:background="@drawable/bg_soft" android:text="@string/zone_note" android:textAppearance="@style/Text.Body" android:textSize="13sp" app:layout_constraintTop_toBottomOf="@id/save" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
