<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
    <ImageView android:layout_width="40dp" android:layout_height="44dp" android:src="@drawable/ic_brand_toolbar"
        android:scaleType="fitCenter" android:contentDescription="@string/app_name"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name"
            android:textSize="14sp" android:fontFamily="@font/jakarta_bold" android:textColor="@color/text_primary"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/drawer_subtitle" android:textSize="11sp" android:textColor="@color/text_secondary"/>
    </LinearLayout>
</LinearLayout>
